<section class="py-24 px-6 md:px-12 relative group overflow-hidden" id="strategi">
    
    <!-- Distinct background (different from Muqaddimah) -->
    <div class="absolute inset-0 bg-gradient-to-br from-surface-container-low via-surface to-primary-fixed/20 -z-20"></div>
    
    <!-- Subtle pattern overlay -->
    <div class="absolute inset-0 opacity-[0.02] -z-10 pointer-events-none" 
         style="background-image: url(&quot;data:image/svg+xml,%3Csvg width='40' height='40' viewBox='0 0 40 40' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23c2652a' fill-opacity='1'%3E%3Cpath d='M20 0L40 20L20 40L0 20Z' fill='none' stroke='%23c2652a' stroke-width='0.5'/%3E%3C/g%3E%3C/svg%3E&quot;);"></div>

    <!-- Edit Overlay -->
    <template x-if="editMode">
        <div class="absolute top-4 right-4 flex gap-2 z-10">
            <button @click="saveData({ strategi: portfolioData.strategi })" class="bg-primary text-on-primary px-3 py-1 rounded text-sm hover:bg-surface-tint">Simpan Strategi</button>
        </div>
    </template>

    <div class="max-w-7xl mx-auto">
        <!-- Section header with decoration -->
        <div class="text-center mb-16" x-data="{ shown: false }" x-intersect.once="shown = true">
            <span class="material-symbols-outlined text-primary text-4xl mb-4 block transition-all duration-1000" :class="shown ? 'opacity-100 scale-100' : 'opacity-0 scale-50'">psychology_alt</span>
            <h2 class="font-headline text-4xl text-on-surface mb-4 transition-all duration-1000 delay-200"
                :contenteditable="editMode"
                x-text="portfolioData.strategi.title"
                @blur="portfolioData.strategi.title = $event.target.innerText"
                :class="shown ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-4'"></h2>
            <div class="w-16 h-px bg-primary mx-auto transition-all duration-1000 delay-400" :class="shown ? 'w-16' : 'w-0'"></div>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 relative">
            <!-- Glow background -->
            <div class="absolute inset-0 bg-primary-container/15 blur-[120px] -z-10 rounded-full pointer-events-none"></div>

            <template x-for="(item, index) in portfolioData.strategi.items" :key="index">
                <div class="bg-surface-container-lowest/70 backdrop-blur-xl rounded-2xl sahara-shadow border border-white/30 relative overflow-hidden
                            transition-all duration-500 hover:-translate-y-2 hover:shadow-xl hover:shadow-primary/10 hover:border-primary/40 group/card"
                     x-data="{ shown: false }" 
                     x-intersect.once="shown = true" 
                     :class="shown ? 'opacity-100 translate-y-0 animate-shadow-drop-2-center' : 'opacity-0 translate-y-12'"
                     :style="`animation-delay: ${index * 200}ms`">
                    
                    <!-- Card header with icon -->
                    <div class="p-8 pb-0">
                        <div class="w-14 h-14 bg-secondary-container/80 backdrop-blur-sm rounded-2xl flex items-center justify-center mb-6 text-on-secondary-container border border-white/40 
                                    group-hover/card:bg-primary group-hover/card:text-on-primary group-hover/card:scale-110 transition-all duration-500">
                            <span class="material-symbols-outlined text-2xl" x-text="item.icon"></span>
                        </div>
                        
                        <template x-if="editMode">
                            <div class="mb-4">
                                <label class="text-xs text-primary mb-1 block">Icon Material:</label>
                                <input type="text" x-model="portfolioData.strategi.items[index].icon" class="w-full text-xs px-2 py-1 border rounded bg-surface">
                            </div>
                        </template>

                        <h3 class="font-headline text-2xl text-on-surface mb-6"
                            :contenteditable="editMode"
                            x-text="item.title"
                            @blur="portfolioData.strategi.items[index].title = $event.target.innerText"></h3>
                    </div>
                    
                    <!-- Challenge section (reddish) -->
                    <div class="mx-8 mb-4 p-5 rounded-xl bg-error-container/30 border border-error/10 relative">
                        <div class="flex items-start gap-3">
                            <span class="material-symbols-outlined text-error text-xl mt-0.5 shrink-0">warning</span>
                            <div>
                                <span class="font-body text-xs font-bold text-error uppercase tracking-wider block mb-1">Tantangan</span>
                                <span class="font-body text-sm text-on-surface-variant leading-relaxed"
                                      :contenteditable="editMode"
                                      x-text="item.challenge"
                                      @blur="portfolioData.strategi.items[index].challenge = $event.target.innerText"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Arrow connector -->
                    <div class="flex justify-center my-2">
                        <span class="material-symbols-outlined text-primary/40 text-2xl">arrow_downward</span>
                    </div>

                    <!-- Solution section (greenish/primary) -->
                    <div class="mx-8 mb-8 p-5 rounded-xl bg-primary-fixed/40 border border-primary/10 relative">
                        <div class="flex items-start gap-3">
                            <span class="material-symbols-outlined text-primary text-xl mt-0.5 shrink-0">lightbulb</span>
                            <div>
                                <span class="font-body text-xs font-bold text-primary uppercase tracking-wider block mb-1">Solusi</span>
                                <span class="font-body text-sm text-on-surface-variant leading-relaxed"
                                      :contenteditable="editMode"
                                      x-text="item.solution"
                                      @blur="portfolioData.strategi.items[index].solution = $event.target.innerText"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Decorative bottom glow -->
                    <div class="absolute -bottom-8 -right-8 w-40 h-40 bg-primary/8 rounded-full blur-3xl opacity-0 group-hover/card:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
                </div>
            </template>
        </div>
    </div>
</section>

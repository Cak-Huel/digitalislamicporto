<section class="relative py-32 px-6 md:px-12 overflow-hidden group" id="visi">
    
    <!-- Wave SVG Separator (top) -->
    <div class="absolute top-0 left-0 w-full overflow-hidden leading-[0] rotate-180">
        <svg class="relative block w-full h-[60px] md:h-[80px]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none">
            <path d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V0H0V27.35A600.21,600.21,0,0,0,321.39,56.44Z" fill="currentColor" class="text-surface-container-low"></path>
        </svg>
    </div>

    <!-- Dark gradient background -->
    <div class="absolute inset-0 bg-gradient-to-b from-inverse-surface via-[#2a2018] to-[#1a1510] -z-20"></div>
    
    <!-- Decorative glow orbs -->
    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-primary/15 rounded-full blur-[150px] -z-10 pointer-events-none"></div>
    <div class="absolute bottom-1/4 right-1/4 w-72 h-72 bg-tertiary/10 rounded-full blur-[120px] -z-10 pointer-events-none"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-primary/5 rounded-full blur-[200px] -z-10 pointer-events-none"></div>

    <!-- Subtle geometric pattern overlay -->
    <div class="absolute inset-0 opacity-[0.03] -z-10 pointer-events-none" 
         style="background-image: url(&quot;data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='1'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E&quot;);"></div>

    <!-- Edit Overlay -->
    <template x-if="editMode">
        <div class="absolute top-4 right-4 flex gap-2 z-10">
            <button @click="saveData({ visi: portfolioData.visi })" class="bg-primary text-on-primary px-3 py-1 rounded text-sm hover:bg-surface-tint">Simpan Visi</button>
        </div>
    </template>

    <div class="max-w-5xl mx-auto relative z-10">
        
        <!-- Header -->
        <div class="text-center mb-20 transition-all duration-1000 ease-out" x-data="{ shown: false }" x-intersect.once="shown = true" :class="shown ? 'opacity-100 scale-100' : 'opacity-0 scale-90'">
            
            <!-- Animated icon -->
            <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-primary/20 backdrop-blur-sm border border-primary/30 mb-8">
                <span class="material-symbols-outlined text-primary-fixed-dim text-4xl animate-pulse">explore</span>
            </div>
            
            <h2 class="font-headline text-4xl md:text-5xl text-inverse-on-surface mb-6 leading-tight"
                :contenteditable="editMode"
                x-text="portfolioData.visi.title"
                @blur="portfolioData.visi.title = $event.target.innerText"></h2>
            
            <div class="w-20 h-px bg-gradient-to-r from-transparent via-primary-fixed-dim to-transparent mx-auto mb-8"></div>
            
            <p class="font-body text-lg md:text-xl text-inverse-on-surface/70 leading-relaxed max-w-3xl mx-auto"
               :contenteditable="editMode"
               x-text="portfolioData.visi.description"
               @blur="portfolioData.visi.description = $event.target.innerText"></p>
        </div>

        <!-- Roadmap Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8 mb-20">
            <template x-for="(item, index) in portfolioData.visi.items" :key="index">
                <div class="relative group/card transition-all duration-1000 ease-out"
                     x-data="{ shown: false }" 
                     x-intersect.once="shown = true" 
                     :class="shown ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-12'"
                     :style="`transition-delay: ${index * 200}ms`">
                    
                    <!-- Card -->
                    <div class="relative bg-white/[0.06] backdrop-blur-xl border border-white/10 rounded-2xl p-8 h-full
                                hover:bg-white/[0.10] hover:border-primary/30 hover:-translate-y-2 hover:shadow-2xl hover:shadow-primary/10
                                transition-all duration-500 overflow-hidden">
                        
                        <!-- Glow top border -->
                        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-1/2 h-px bg-gradient-to-r from-transparent via-primary-fixed-dim/60 to-transparent"></div>
                        
                        <!-- Large number -->
                        <span class="font-headline text-7xl font-bold text-primary/20 block mb-4 leading-none group-hover/card:text-primary/40 transition-colors duration-500"
                              :contenteditable="editMode"
                              x-text="item.number"
                              @blur="portfolioData.visi.items[index].number = $event.target.innerText"></span>
                        
                        <!-- Divider line -->
                        <div class="w-10 h-0.5 bg-gradient-to-r from-primary-fixed-dim to-transparent mb-4"></div>
                        
                        <!-- Text -->
                        <span class="font-headline text-xl text-inverse-on-surface/90 block"
                              :contenteditable="editMode"
                              x-text="item.text"
                              @blur="portfolioData.visi.items[index].text = $event.target.innerText"></span>
                        
                        <!-- Decorative corner glow -->
                        <div class="absolute -bottom-8 -right-8 w-32 h-32 bg-primary/10 rounded-full blur-2xl opacity-0 group-hover/card:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
                    </div>
                </div>
            </template>
        </div>

        <!-- Connecting dots between cards (desktop) -->
        <div class="hidden md:flex justify-center items-center gap-3 -mt-16 mb-16">
            <div class="w-2 h-2 rounded-full bg-primary/40"></div>
            <div class="w-16 h-px bg-gradient-to-r from-primary/40 to-primary/10"></div>
            <div class="w-2 h-2 rounded-full bg-primary/30"></div>
            <div class="w-16 h-px bg-gradient-to-r from-primary/30 to-primary/10"></div>
            <div class="w-2 h-2 rounded-full bg-primary/20"></div>
        </div>

        <!-- CTA Section -->
        <div class="text-center transition-all duration-1000 ease-out" x-data="{ shown: false }" x-intersect.once="shown = true" :class="shown ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-8'">
            <p class="font-body text-inverse-on-surface/50 text-sm mb-6 tracking-wider uppercase">Siap Berkolaborasi?</p>
            <a
                href="https://wa.me/6287841410773"
                target="_blank"
                class="inline-flex items-center gap-3 bg-primary text-on-primary px-10 py-4 rounded-xl font-body font-semibold text-lg
                       hover:bg-surface-tint hover:scale-105 
                       animate-pulse-glow
                       transition-all duration-300 group/cta"
            >
                <span>Mulai Kolaborasi</span>
                <span class="material-symbols-outlined text-xl group-hover/cta:translate-x-1 transition-transform duration-300">arrow_forward</span>
            </a>
        </div>
    </div>
</section>

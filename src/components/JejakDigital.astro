---
import FootprintSteps from './FootprintSteps.astro';
const backgroundImage = "/wave-sahara.svg";
---
<section 
    class="relative w-full min-h-[60vh] md:min-h-screen py-24 px-6 md:px-12 flex items-center justify-center bg-[#ffe0b7] bg-cover bg-center bg-no-repeat overflow-hidden group" 
    id="jejak-digital"
    style={`background-image: url('${backgroundImage}');`}
>
    <!-- Edit Overlay -->
    <template x-if="editMode">
        <div class="absolute top-4 right-4 flex gap-2 z-20">
            <button @click="saveData({ jejak_digital: portfolioData.jejak_digital })" class="bg-primary text-on-primary px-3 py-1 rounded text-sm hover:bg-surface-tint">Simpan Jejak Digital</button>
        </div>
    </template>

    <div class="relative z-10 w-full max-w-7xl mx-auto">
        <div class="text-center mb-16 transition-all duration-1000 ease-out" x-data="{ shown: false }" x-intersect.once="shown = true" :class="shown ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-12'">
            <FootprintSteps />
            
            <h2 class="font-headline text-4xl text-on-surface mb-4"
                :contenteditable="editMode"
                x-text="portfolioData.jejak_digital.title"
                @blur="portfolioData.jejak_digital.title = $event.target.innerText"></h2>
            <p class="font-body text-on-surface-variant max-w-2xl mx-auto"
               :contenteditable="editMode"
               x-text="portfolioData.jejak_digital.description"
               @blur="portfolioData.jejak_digital.description = $event.target.innerText"></p>
        </div>

        <!-- Glow background behind cards -->
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-3/4 h-3/4 bg-primary/10 rounded-full blur-[120px] -z-10 pointer-events-none"></div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 auto-rows-[minmax(180px,auto)]">
            
            <!-- Item 1 (Light Card) -->
            <div class="md:col-span-2 bg-white/40 backdrop-blur-xl p-8 rounded-xl border border-white/20 sahara-shadow group hover:border-primary/50 transition-all duration-1000 relative" x-data="{ shown: false }" x-intersect.once="shown = true" :class="shown ? 'opacity-100 translate-y-0 animate-shadow-drop-2-center' : 'opacity-0 translate-y-12'" :style="`animation-delay: 100ms`">
                <div class="flex justify-between items-start mb-4">
                    <h3 class="font-headline text-2xl text-on-surface"
                        :contenteditable="editMode"
                        x-text="portfolioData.jejak_digital.items[0].title"
                        @blur="portfolioData.jejak_digital.items[0].title = $event.target.innerText"></h3>
                    <span class="material-symbols-outlined text-primary text-3xl" x-text="portfolioData.jejak_digital.items[0].icon"></span>
                </div>
                <p class="font-body text-on-surface-variant mt-2"
                   :contenteditable="editMode"
                   x-text="portfolioData.jejak_digital.items[0].description"
                   @blur="portfolioData.jejak_digital.items[0].description = $event.target.innerText"></p>
                
                <template x-if="editMode">
                    <div class="mt-2">
                        <label class="text-xs text-primary mb-1 block">Icon Material:</label>
                        <input type="text" x-model="portfolioData.jejak_digital.items[0].icon" class="w-full text-xs px-2 py-1 border rounded bg-surface-container text-black">
                    </div>
                </template>
            </div>

            <!-- Item 2 (Dark Card) -->
            <div class="bg-primary backdrop-blur-xl text-white p-8 rounded-xl border border-white/20 sahara-shadow flex flex-col justify-center relative transition-all duration-1000" x-data="{ shown: false }" x-intersect.once="shown = true" :class="shown ? 'opacity-100 translate-y-0 animate-shadow-drop-2-center' : 'opacity-0 translate-y-12'" :style="`animation-delay: 200ms`">
                <span class="material-symbols-outlined text-4xl mb-4 text-on-primary-fixed-variant" x-text="portfolioData.jejak_digital.items[1].icon"></span>
                <h3 class="font-headline text-2xl mb-2"
                    :contenteditable="editMode"
                    x-text="portfolioData.jejak_digital.items[1].title"
                    @blur="portfolioData.jejak_digital.items[1].title = $event.target.innerText"></h3>
                <p class="font-body text-sm opacity-90 text-on-primary-fixed"
                   :contenteditable="editMode"
                   x-text="portfolioData.jejak_digital.items[1].description"
                   @blur="portfolioData.jejak_digital.items[1].description = $event.target.innerText"></p>

                <template x-if="editMode">
                    <div class="mt-2">
                        <input type="text" x-model="portfolioData.jejak_digital.items[1].icon" class="w-full text-xs px-2 py-1 border rounded bg-surface-container text-black">
                    </div>
                </template>
            </div>

            <!-- Item 3 (Light Card) -->
            <div class="bg-white/30 backdrop-blur-xl p-8 rounded-xl border border-white/10 sahara-shadow relative transition-all duration-1000" x-data="{ shown: false }" x-intersect.once="shown = true" :class="shown ? 'opacity-100 translate-y-0 animate-shadow-drop-2-center' : 'opacity-0 translate-y-12'" :style="`animation-delay: 300ms`">
                <span class="material-symbols-outlined text-tertiary text-3xl mb-4" x-text="portfolioData.jejak_digital.items[2].icon"></span>
                <h3 class="font-headline text-xl text-on-surface mb-2"
                    :contenteditable="editMode"
                    x-text="portfolioData.jejak_digital.items[2].title"
                    @blur="portfolioData.jejak_digital.items[2].title = $event.target.innerText"></h3>
                <p class="font-body text-sm text-on-surface-variant"
                   :contenteditable="editMode"
                   x-text="portfolioData.jejak_digital.items[2].description"
                   @blur="portfolioData.jejak_digital.items[2].description = $event.target.innerText"></p>

                <template x-if="editMode">
                    <div class="mt-2">
                        <input type="text" x-model="portfolioData.jejak_digital.items[2].icon" class="w-full text-xs px-2 py-1 border rounded bg-surface-container text-black">
                    </div>
                </template>
            </div>

            <!-- Item 4 (Light Card) -->
            <div class="md:col-span-2 bg-white/40 backdrop-blur-xl p-8 rounded-xl border border-white/20 sahara-shadow flex flex-col justify-between overflow-hidden relative transition-all duration-1000" x-data="{ shown: false }" x-intersect.once="shown = true" :class="shown ? 'opacity-100 translate-y-0 animate-shadow-drop-2-center' : 'opacity-0 translate-y-12'" :style="`animation-delay: 400ms`">
                <div class="relative z-10">
                    <span class="material-symbols-outlined text-primary text-3xl mb-4" x-text="portfolioData.jejak_digital.items[3].icon"></span>
                    <h3 class="font-headline text-2xl text-on-surface mb-2"
                        :contenteditable="editMode"
                        x-text="portfolioData.jejak_digital.items[3].title"
                        @blur="portfolioData.jejak_digital.items[3].title = $event.target.innerText"></h3>
                    <p class="font-body text-on-surface-variant max-w-md"
                       :contenteditable="editMode"
                       x-text="portfolioData.jejak_digital.items[3].description"
                       @blur="portfolioData.jejak_digital.items[3].description = $event.target.innerText"></p>

                    <template x-if="editMode">
                        <div class="mt-2 max-w-xs">
                            <input type="text" x-model="portfolioData.jejak_digital.items[3].icon" class="w-full text-xs px-2 py-1 border rounded bg-surface-container text-black">
                        </div>
                    </template>
                </div>
                <div class="absolute -bottom-10 -right-10 w-48 h-48 bg-primary/10 rounded-full blur-3xl z-0 pointer-events-none"></div>
            </div>

        </div>
    </div>
</section>

        </div>
    </div>
</section>

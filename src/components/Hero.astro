<section
    class="relative w-full min-h-screen flex items-center justify-center overflow-hidden border-b border-outline-variant/30"
>
    <!-- Vanta.js Clouds Background -->
    <div id="vanta-bg" class="absolute top-0 left-0 w-full h-full z-0 opacity-50 mix-blend-multiply pointer-events-none" style="width: 100%; height: 100%; min-height: 100vh;"></div>

    <script
        is:inline
        src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r134/three.min.js"
    ></script>
    <script
        is:inline
        src="https://cdn.jsdelivr.net/npm/vanta@latest/dist/vanta.clouds.min.js"
    ></script>
    <style is:global>
        .vanta-canvas {
            width: 100% !important;
            height: 100% !important;
        }
    </style>

    <script is:inline>
        document.addEventListener("DOMContentLoaded", function () {
            if (window.VANTA) {
                // Ensure the container has dimensions before initializing
                setTimeout(() => {
                    var vantaEffect = window.VANTA.CLOUDS({
                        el: "#vanta-bg",
                        mouseControls: false,
                        touchControls: false,
                        gyroControls: false,
                        minHeight: 200.0,
                        minWidth: 200.0,
                        skyColor: 0x68b8d7,
                        cloudColor: 0xadc1d0,
                        cloudShadowColor: 0x183550,
                        sunColor: 0xff9919,
                        sunGlareColor: 0xff6633,
                        sunPosition: { x: 3, y: -0.5, z: 1 },
                    });
                }, 100);
            }
        });
    </script>

    <div
        class="pt-40 pb-24 px-6 md:px-12 max-w-7xl mx-auto flex flex-col items-center text-center relative z-10 group w-full"
    >
        <!-- Edit Overlay -->
        <template x-if="editMode">
            <div class="absolute top-4 right-4 flex gap-2 z-20">
                <button
                    @click="saveData({ hero: portfolioData.hero })"
                    class="bg-primary text-on-primary px-3 py-1 rounded text-sm hover:bg-surface-tint"
                    >Simpan</button
                >
            </div>
        </template>

        <span
            class="text-tertiary font-body tracking-widest uppercase text-sm mb-6 font-semibold"
            :class="shown ? 'animate-tracking-in-expand' : 'opacity-0'"
            x-data="{ shown: false }"
            x-intersect.once="shown = true"
        >
            Digital Islamic Educator Portfolio
        </span>

        <h1
            class="font-headline text-5xl md:text-7xl text-on-surface font-medium leading-tight mb-8 max-w-4xl"
            :contenteditable="editMode"
            x-html="portfolioData.hero.title"
            @blur="portfolioData.hero.title = $event.target.innerHTML"
            x-data="{ shown: false }"
            x-intersect.once="shown = true"
            :class="shown ? 'animate-text-focus-in' : 'opacity-0'"
            style="animation-delay: 500ms;"
        >
        </h1>

        <p
            class="font-body text-lg md:text-xl text-on-surface-variant max-w-2xl leading-relaxed mb-12 transition-all duration-1000 ease-out delay-[1000ms]"
            :contenteditable="editMode"
            x-html="portfolioData.hero.description"
            @blur="portfolioData.hero.description = $event.target.innerHTML"
            x-data="{ shown: false }"
            x-intersect.once="shown = true"
            :class="shown ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-8'"
        >
        </p>

        <div
            class="flex gap-4 transition-all duration-1000 ease-out delay-[1200ms]"
            x-data="{ shown: false }"
            x-intersect.once="shown = true"
            :class="shown ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-8'"
        >
            <a
                href="#muqaddimah"
                class="bg-primary text-on-primary px-8 py-3 rounded-lg font-body font-medium transition-colors hover:bg-surface-tint"
            >
                Mulai Jelajahi
            </a>
            <a
                href="#galeri-inovasi"
                class="border border-outline bg-transparent text-on-surface px-8 py-3 rounded-lg font-body font-medium transition-colors hover:bg-surface-container-low"
            >
                Lihat Karya
            </a>
        </div>
    </div>
</section>

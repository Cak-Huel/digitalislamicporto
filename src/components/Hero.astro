<section
    class="relative w-full min-h-screen flex items-center justify-center overflow-hidden"
>
    <!-- Vanta.js Clouds Background -->
    <div id="vanta-bg" class="absolute top-0 left-0 w-full h-full z-0 opacity-50 mix-blend-multiply pointer-events-none" style="width: 100%; height: 100%; min-height: 100vh;"></div>

    <script
        is:inline
        src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r134/three.min.js"
    ></script>
    <script
        is:inline
        src="https://cdn.jsdelivr.net/npm/vanta@latest/dist/vanta.clouds.min.js"
    ></script>
    <style is:global>
        .vanta-canvas {
            width: 100% !important;
            height: 100% !important;
        }
    </style>

    <script is:inline>
        document.addEventListener("DOMContentLoaded", function () {
            if (window.VANTA) {
                // Ensure the container has dimensions before initializing
                setTimeout(() => {
                    var vantaEffect = window.VANTA.CLOUDS({
                        el: "#vanta-bg",
                        mouseControls: false,
                        touchControls: false,
                        gyroControls: false,
                        minHeight: 200.0,
                        minWidth: 200.0,
                        skyColor: 0x68b8d7,
                        cloudColor: 0xadc1d0,
                        cloudShadowColor: 0x183550,
                        sunColor: 0xff9919,
                        sunGlareColor: 0xff6633,
                        sunPosition: { x: 3, y: -0.5, z: 1 },
                    });
                }, 100);
            }
        });
    </script>

    <!-- Floating Islamic Geometric Patterns -->
    <div class="absolute inset-0 z-[1] pointer-events-none overflow-hidden" aria-hidden="true">
        <!-- Pattern 1: Octagonal star (top-left) -->
        <svg class="absolute top-[10%] left-[5%] w-20 h-20 md:w-28 md:h-28 text-primary/[0.07] animate-float-slow" viewBox="0 0 100 100" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
            <polygon points="50,0 61,18 82,10 74,32 100,38 82,50 100,62 74,68 82,90 61,82 50,100 39,82 18,90 26,68 0,62 18,50 0,38 26,32 18,10 39,18"/>
        </svg>
        <!-- Pattern 2: Crescent (top-right) -->
        <svg class="absolute top-[15%] right-[8%] w-16 h-16 md:w-24 md:h-24 text-tertiary/[0.06] animate-float-medium" viewBox="0 0 100 100" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
            <path d="M50 5C25.2 5 5 25.2 5 50s20.2 45 45 45c8.3 0 16.1-2.3 22.8-6.2C59.5 83.5 50 68 50 50s9.5-33.5 22.8-38.8C66.1 7.3 58.3 5 50 5z"/>
        </svg>
        <!-- Pattern 3: Square Kufic cross (center-left) -->
        <svg class="absolute top-[55%] left-[3%] w-14 h-14 md:w-20 md:h-20 text-primary/[0.05] animate-float-reverse" viewBox="0 0 100 100" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
            <rect x="35" y="0" width="30" height="100"/>
            <rect x="0" y="35" width="100" height="30"/>
        </svg>
        <!-- Pattern 4: 8-pointed star (bottom-right) -->
        <svg class="absolute bottom-[20%] right-[5%] w-24 h-24 md:w-32 md:h-32 text-primary/[0.06] animate-float-slow [animation-delay:2s]" viewBox="0 0 100 100" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
            <polygon points="50,0 58,35 95,20 65,42 100,50 65,58 95,80 58,65 50,100 42,65 5,80 35,58 0,50 35,42 5,20 42,35"/>
        </svg>
        <!-- Pattern 5: Diamond (center-right) -->
        <svg class="absolute top-[40%] right-[15%] w-10 h-10 md:w-14 md:h-14 text-tertiary/[0.05] animate-float-medium [animation-delay:1s]" viewBox="0 0 100 100" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
            <polygon points="50,0 100,50 50,100 0,50"/>
        </svg>
        <!-- Pattern 6: Small dots cluster (bottom-left) -->
        <svg class="absolute bottom-[25%] left-[10%] w-16 h-16 md:w-20 md:h-20 text-primary/[0.04] animate-float-reverse [animation-delay:3s]" viewBox="0 0 100 100" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
            <circle cx="20" cy="20" r="8"/>
            <circle cx="50" cy="10" r="5"/>
            <circle cx="80" cy="25" r="7"/>
            <circle cx="30" cy="55" r="6"/>
            <circle cx="65" cy="50" r="9"/>
            <circle cx="50" cy="80" r="7"/>
            <circle cx="15" cy="85" r="5"/>
            <circle cx="85" cy="75" r="6"/>
        </svg>
    </div>

    <div
        class="pt-40 pb-24 px-6 md:px-12 max-w-7xl mx-auto flex flex-col items-center text-center relative z-10 group w-full"
    >
        <!-- Edit Overlay -->
        <template x-if="editMode">
            <div class="absolute top-4 right-4 flex gap-2 z-20">
                <button
                    @click="saveData({ hero: portfolioData.hero })"
                    class="bg-primary text-on-primary px-3 py-1 rounded text-sm hover:bg-surface-tint"
                    >Simpan</button
                >
            </div>
        </template>

        <span
            class="text-tertiary font-body tracking-widest uppercase text-sm mb-6 font-semibold"
            :class="shown ? 'animate-tracking-in-expand' : 'opacity-0'"
            x-data="{ shown: false }"
            x-intersect.once="shown = true"
        >
            Digital Islamic Educator Portfolio
        </span>

        <h1
            class="font-headline text-5xl md:text-7xl text-on-surface font-medium leading-tight mb-8 max-w-4xl"
            :contenteditable="editMode"
            x-html="portfolioData.hero.title"
            @blur="portfolioData.hero.title = $event.target.innerHTML"
            x-data="{ shown: false }"
            x-intersect.once="shown = true"
            :class="shown ? 'animate-text-focus-in' : 'opacity-0'"
            style="animation-delay: 500ms;"
        >
        </h1>

        <p
            class="font-body text-lg md:text-xl text-on-surface-variant max-w-2xl leading-relaxed mb-12 transition-all duration-1000 ease-out delay-[1000ms]"
            :contenteditable="editMode"
            x-html="portfolioData.hero.description"
            @blur="portfolioData.hero.description = $event.target.innerHTML"
            x-data="{ shown: false }"
            x-intersect.once="shown = true"
            :class="shown ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-8'"
        >
        </p>

        <div
            class="flex gap-4 transition-all duration-1000 ease-out delay-[1200ms]"
            x-data="{ shown: false }"
            x-intersect.once="shown = true"
            :class="shown ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-8'"
        >
            <a
                href="#muqaddimah"
                class="bg-primary text-on-primary px-8 py-3 rounded-lg font-body font-medium transition-all duration-300 hover:bg-surface-tint hover:scale-105 hover:shadow-lg hover:shadow-primary/20"
            >
                Mulai Jelajahi
            </a>
            <a
                href="#galeri-inovasi"
                class="border border-outline bg-transparent text-on-surface px-8 py-3 rounded-lg font-body font-medium transition-all duration-300 hover:bg-surface-container-low hover:scale-105 hover:shadow-lg"
            >
                Lihat Karya
            </a>
        </div>
    </div>

    <!-- Wave separator bottom -->
    <div class="absolute bottom-0 left-0 w-full overflow-hidden leading-[0] z-10">
        <svg class="relative block w-full h-[50px] md:h-[70px]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none">
            <path d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V120H0V27.35A600.21,600.21,0,0,0,321.39,56.44Z" fill="currentColor" class="text-surface-container-low"></path>
        </svg>
    </div>
</section>

<style>
    @keyframes float-slow {
        0%, 100% { transform: translateY(0) rotate(0deg); }
        50% { transform: translateY(-20px) rotate(8deg); }
    }
    @keyframes float-medium {
        0%, 100% { transform: translateY(0) rotate(0deg); }
        50% { transform: translateY(-15px) rotate(-6deg); }
    }
    @keyframes float-reverse {
        0%, 100% { transform: translateY(0) rotate(0deg); }
        50% { transform: translateY(15px) rotate(5deg); }
    }
    .animate-float-slow { animation: float-slow 8s ease-in-out infinite; }
    .animate-float-medium { animation: float-medium 6s ease-in-out infinite; }
    .animate-float-reverse { animation: float-reverse 7s ease-in-out infinite; }
</style>

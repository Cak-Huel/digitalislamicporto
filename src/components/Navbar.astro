<nav
    x-data="{
        mobileMenuOpen: false,
        scrolled: false,
        activeSection: '',
        sections: ['muqaddimah', 'jejak-digital', 'galeri-inovasi', 'khidmah', 'strategi', 'visi'],
        initObserver() {
            const options = {
                root: null,
                rootMargin: '-20% 0px -60% 0px',
                threshold: 0
            };
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        this.activeSection = entry.target.id;
                    }
                });
            }, options);
            this.sections.forEach(id => {
                const el = document.getElementById(id);
                if (el) observer.observe(el);
            });
        }
    }"
    x-init="initObserver()"
    @scroll.window="scrolled = window.scrollY > 80"
    class="fixed top-0 w-full z-50 backdrop-blur-md border-b shadow-sm transition-all duration-500"
    :class="scrolled 
        ? 'bg-background/95 border-outline-variant/60 shadow-md' 
        : 'bg-background/60 border-transparent shadow-none'"
>
    <div
        class="flex justify-between items-center px-6 md:px-12 max-w-full transition-all duration-500"
        :class="scrolled ? 'py-3' : 'py-4'"
    >
        <div class="font-headline font-bold text-primary transition-all duration-500"
             :class="scrolled ? 'text-xl' : 'text-2xl'">
            Islamic Portofolio
        </div>

        <!-- Desktop Menu -->
        <div
            class="hidden md:flex items-center transition-all duration-300"
            :class="scrolled ? 'space-x-6' : 'space-x-8'"
        >
            <template
                x-for="item in [
                { id: 'muqaddimah', label: 'Muqaddimah' },
                { id: 'jejak-digital', label: 'Jejak Digital' },
                { id: 'galeri-inovasi', label: 'Galeri Inovasi' },
                { id: 'khidmah', label: 'Khidmah' },
                { id: 'strategi', label: 'Strategi' },
                { id: 'visi', label: 'Visi' }
            ]"
                :key="item.id"
            >
                <a
                    :href="'#' + item.id"
                    :class="activeSection === item.id 
                        ? 'text-primary border-b-2 border-primary font-semibold' 
                        : 'text-on-surface-variant border-b-2 border-transparent'"
                    class="font-headline italic hover:text-primary transition-all duration-300 cursor-pointer active:opacity-70 pb-1"
                    :class-2="scrolled ? 'text-base' : 'text-lg'"
                    x-text="item.label"
                >
                </a>
            </template>
        </div>

        <a
            href="https://wa.me/6287841410773"
            target="_blank"
            class="hidden md:block bg-primary hover:bg-surface-tint text-on-primary font-body font-medium rounded border border-transparent transition-all duration-300 cursor-pointer active:opacity-70 hover:scale-105 hover:shadow-lg"
            :class="scrolled ? 'px-5 py-1.5 text-sm' : 'px-6 py-2'"
        >
            Hubungi Saya
        </a>

        <!-- Hamburger Icon -->
        <button
            @click="mobileMenuOpen = !mobileMenuOpen"
            class="md:hidden text-primary focus:outline-none"
        >
            <span
                class="material-symbols-outlined text-3xl"
                x-text="mobileMenuOpen ? 'close' : 'menu'"></span>
        </button>
    </div>

    <!-- Mobile Menu -->
    <div
        x-show="mobileMenuOpen"
        x-transition:enter="transition ease-out duration-200"
        x-transition:enter-start="opacity-0 -translate-y-2"
        x-transition:enter-end="opacity-100 translate-y-0"
        x-transition:leave="transition ease-in duration-150"
        x-transition:leave-start="opacity-100 translate-y-0"
        x-transition:leave-end="opacity-0 -translate-y-2"
        class="md:hidden bg-surface/95 backdrop-blur-lg border-b border-outline-variant/60 shadow-lg absolute w-full"
        style="display: none;"
    >
        <div class="flex flex-col px-6 py-4 space-y-4">
            <template
                x-for="item in [
                { id: 'muqaddimah', label: 'Muqaddimah' },
                { id: 'jejak-digital', label: 'Jejak Digital' },
                { id: 'galeri-inovasi', label: 'Galeri Inovasi' },
                { id: 'khidmah', label: 'Khidmah' },
                { id: 'strategi', label: 'Strategi' },
                { id: 'visi', label: 'Visi' }
            ]"
                :key="item.id"
            >
                <a
                    @click="mobileMenuOpen = false"
                    :href="'#' + item.id"
                    class="font-headline text-lg italic transition-colors duration-200 py-1"
                    :class="activeSection === item.id 
                        ? 'text-primary font-semibold' 
                        : 'text-on-surface hover:text-primary'"
                    x-text="item.label"
                >
                </a>
            </template>
            <a
                @click="mobileMenuOpen = false"
                href="https://wa.me/6287841410773"
                target="_blank"
                class="bg-primary text-on-primary font-body font-medium px-4 py-2 rounded text-center hover:bg-surface-tint transition-colors"
                >Hubungi Saya</a
            >
        </div>
    </div>
</nav>

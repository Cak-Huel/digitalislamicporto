---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Login - Digital Islamic Educator">
    <div class="min-h-screen flex items-center justify-center px-6">
        <div class="max-w-md w-full bg-surface-container-lowest p-8 rounded-xl sahara-shadow border border-outline-variant/60" x-data="{
            email: '',
            password: '',
            error: '',
            loading: false,
            async doLogin() {
                this.loading = true;
                this.error = '';
                try {
                    const { signInWithEmailAndPassword } = await import('https://www.gstatic.com/firebasejs/10.11.1/firebase-auth.js');
                    await signInWithEmailAndPassword(window.firebaseAuth, this.email, this.password);
                    window.location.href = '/';
                } catch(e) {
                    console.error(e);
                    this.error = 'Login gagal: Email atau password salah.';
                } finally {
                    this.loading = false;
                }
            }
        }">
            <div class="text-center mb-8">
                <span class="material-symbols-outlined text-primary text-5xl mb-4">admin_panel_settings</span>
                <h1 class="font-headline text-3xl text-on-surface font-medium">Masuk Admin</h1>
                <p class="font-body text-on-surface-variant text-sm mt-2">Masuk dengan akun Firebase Anda</p>
            </div>

            <div x-show="error" class="mb-4 p-3 bg-error-container text-on-error-container rounded text-sm font-body" x-text="error" style="display: none;"></div>

            <form @submit.prevent="doLogin" class="space-y-6">
                <div>
                    <label class="block font-body text-sm font-medium text-on-surface mb-2">Email</label>
                    <input type="email" x-model="email" required class="w-full px-4 py-2 border border-outline-variant rounded-lg focus:ring-2 focus:ring-primary focus:border-primary bg-surface font-body text-on-surface" placeholder="admin@example.com">
                </div>
                <div>
                    <label class="block font-body text-sm font-medium text-on-surface mb-2">Password</label>
                    <input type="password" x-model="password" required class="w-full px-4 py-2 border border-outline-variant rounded-lg focus:ring-2 focus:ring-primary focus:border-primary bg-surface font-body text-on-surface" placeholder="Masukkan password">
                </div>
                <button type="submit" :disabled="loading" class="w-full bg-primary text-on-primary py-3 rounded-lg font-body font-medium transition-colors hover:bg-surface-tint disabled:opacity-70 disabled:cursor-not-allowed">
                    <span x-show="!loading">Masuk</span>
                    <span x-show="loading" style="display: none;">Memproses...</span>
                </button>
            </form>
            <div class="text-center mt-6">
                <a href="/" class="text-sm font-body text-primary hover:underline">Kembali ke Beranda</a>
            </div>
        </div>
    </div>
</Layout>
